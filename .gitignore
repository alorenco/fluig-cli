# Binários locais
/fluigcli
/fluigcli.exe
/bin/

# goreleaser
/dist/

# Cobertura e artefatos de teste
*.out
*.test

# Config de projeto que a própria CLI grava quando é executada daqui (o repo
# vira a "raiz do projeto" e comandos como `form export` criam este diretório).
# É configuração de máquina, não do repo da ferramenta.
/.fluigcli/

# Documentos de trabalho do mantenedor (não publicados). Todos moram em
# /docs/interno/ — ROADMAP*.md, DIARIO.md e FLUIG-APIS.md. O VitePress ignora
# essa pasta pelo srcExclude em docs/.vitepress/config.mts.
/docs/interno/

# O guia do agente fica na raiz porque o Claude Code só carrega de lá.
/CLAUDE.md

# Site de documentação (VitePress) — toolchain e build ficam fora do Git
/docs/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
