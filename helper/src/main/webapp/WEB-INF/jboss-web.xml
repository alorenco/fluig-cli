<?xml version="1.0" encoding="UTF-8"?>
<jboss-web>
    <context-root>/fluigcliHelper</context-root>

    <!-- Cross-context DESLIGADO (helper 0.10.3, ROADMAP §2.11-E). Herdamos
         `false` do fluig-widget-helper, e isso deixava outro webapp do mesmo
         servidor obter o ServletContext do helper e despachar internamente para
         /api/*. Dispatch interno NÃO passa pela security-constraint do
         container, então sobraria só o gate da aplicação. O helper não usa
         cross-context em lugar nenhum: o WidgetService resolve o caminho dos
         WARs por getRealPath, que não depende disto. -->
    <disable-cross-context>true</disable-cross-context>

    <security-domain>TOTVSTech</security-domain>

    <security-role>
        <role-name>user</role-name>
        <principal-name>totvstech</principal-name>
    </security-role>

    <security-role>
        <role-name>totvstech</role-name>
        <principal-name>totvstech</principal-name>
    </security-role>

    <security-role>
        <role-name>sysadmin</role-name>
        <principal-name>wcmadmin</principal-name>
    </security-role>

    <security-role>
        <role-name>admin</role-name>
        <principal-name>wcmadmin</principal-name>
    </security-role>
</jboss-web>
